{
  "include": ["**/*.ts", "**/*.tsx", "./module.d.ts"],
  "compilerOptions": {
    "target": "es2023",
    "jsx": "react-jsx",
    "module": "ESNext",
    // ESNext.Temporal supplies the ambient `Temporal` namespace. temporal-polyfill
    // v1 no longer ships it: `/global` is runtime-only there, so the types must
    // come from the TS lib. Still esnext-only — fold into the ES lib once
    // TypeScript ships an ES2026 lib.
    "lib": ["ES2023", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ens-apps/utils": ["../../packages/utils/src"]
    }
  }
}
