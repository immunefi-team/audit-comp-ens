# E2E infra secrets — copy to `e2e/infra/.env` (gitignored). Docker compose
# auto-loads this file for variable interpolation in docker-compose.yml.
#
# Everything below is OPTIONAL for local use: with nothing set, the dqa
# service runs in dev mode (local "Continue in dev mode" sign-in, dry-run
# Linear pushes). Set these for real "Sign in with Linear" + real pushes —
# full walkthrough in packages/dqa-server/AUTH_PLAN.md.

# --- DQA: Linear OAuth app (Linear > Settings > API > OAuth applications) ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Must match the OAuth app's callback. Local: http://localhost:4000/auth/callback
# Hosted: https://<dqa-host>/auth/callback
LINEAR_REDIRECT_URI=http://localhost:4000/auth/callback
# `write` is required for screenshot uploads + sub-issue/triage creation.
# LINEAR_SCOPES=read,write
# LINEAR_ACTOR=user

# --- DQA: workspace gating (required for real auth; see AUTH_PLAN.md §1.4) ---
LINEAR_WORKSPACE_ID=
# LINEAR_ALLOWED_TEAM_IDS=
# LINEAR_ALLOWED_PROJECT_IDS=

# --- DQA: session crypto (random strings; required on a shared/hosted server) ---
DQA_SESSION_SECRET=
DQA_TOKEN_ENCRYPTION_KEY=
# Allow dev login even when OAuth is configured (local testing only)
# DQA_DEV_AUTH=false

# --- DQA: allowed origins (CORS / OAuth returns / WebSocket) ---
# Comma-separated exact origins or `*` wildcards. Required on a hosted server.
# Include the PR-preview host so previews can reach DQA, e.g.:
# DQA_ALLOWED_ORIGINS=https://*.workers.dev,https://app.ens.dev
# (Left blank, only loopback/private-network origins are allowed — local dev.)
DQA_ALLOWED_ORIGINS=

# --- DQA: fallback push via app key (dev mode only) ---
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_LABEL_ID=
# LINEAR_DRY_RUN=true

# --- Other infra ---
# SEPOLIA_FORK_URL=https://ethereum-sepolia-rpc.publicnode.com
