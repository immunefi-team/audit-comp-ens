# Copy to .env and fill in. With NOTHING set, the service runs in dev mode:
# anyone can "Continue in dev mode" and Linear pushes are dry-run (logged only).
PORT=4000

# ======================================================================
#  Auth — "Sign in with Linear" (OAuth2)
#  Create the OAuth app: Linear > Settings > API > OAuth applications.
#  See AUTH_PLAN.md for the full walkthrough.
# ======================================================================
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:4000/auth/callback
LINEAR_SCOPES=read,write                    # `write` needed for screenshot uploads + sub-issue/triage creation
LINEAR_ACTOR=user                           # "user" = comments authored by the real reviewer; or "application"

# --- Whitelist (set the strictness you want; workspace is the coarse gate) ---
# Find these via the GraphQL queries in AUTH_PLAN.md §1.4
LINEAR_WORKSPACE_ID=                         # required for real gating — your organization id
LINEAR_ALLOWED_TEAM_IDS=                     # optional, comma-separated team ids
LINEAR_ALLOWED_PROJECT_IDS=                  # optional, comma-separated project ids

# --- Session / crypto ---
SESSION_SECRET=                              # random string; signs DQA session JWTs (auto-generated if blank)
TOKEN_ENCRYPTION_KEY=                        # used to encrypt the embedded Linear token (falls back to SESSION_SECRET)

# --- Delegated auth (ephemeral deployments, e.g. per-PR preview envs) ---
# Linear requires exact registered redirect URIs, so ephemeral domains can't
# complete OAuth themselves. Point DQA_AUTH_URL at a long-lived instance whose
# /auth/callback IS registered; the overlay opens sign-in popups there and the
# session it mints is valid here. REQUIRES both instances to share the same
# explicit SESSION_SECRET (and TOKEN_ENCRYPTION_KEY) — auto-generated secrets
# differ per instance and delegation will fail with 401s.
DQA_AUTH_URL=

# Allow dev login even when OAuth IS configured (useful for local testing). Default off.
DQA_DEV_AUTH=false

# ======================================================================
#  Linear push — fallback path (only used in dev mode / no signed-in token)
# ======================================================================
LINEAR_API_KEY=                              # personal key; only for the dev/app-key fallback
LINEAR_TEAM_ID=                              # team for the "create a new issue" fallback
LINEAR_LABEL_ID=                             # optional label on fallback-created issues
LINEAR_DRY_RUN=true                          # "false" to actually create via the app key
