{
  "name": "apps",
  "private": true,
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "knip": "LINGUI_CONFIG=apps/manager/lingui.config.ts knip",
    "prepare": "lefthook install",
    "test": "pnpm test:portal",
    "test:all": "pnpm -r test",
    "test:all:cov": "pnpm -r test:coverage",
    "test:portal": "pnpm -r --filter=portal test",
    "test:portal:watch": "pnpm -r --filter=portal test:watch",
    "test:portal:ui": "pnpm -r --filter=portal test:ui",
    "test:portal:cov": "pnpm -r --filter=portal test:coverage",
    "test:portal:cov:open": "pnpm -r --filter=portal test:coverage:open",
    "typecheck:portal": "pnpm -r --filter=portal typecheck",
    "typecheck:manager": "pnpm -r --filter=manager typecheck",
    "build:portal": "pnpm -r --filter=portal build",
    "build:manager": "pnpm -r --filter=manager build",
    "build": "pnpm -w --filter=portal build",
    "dev:manager": "pnpm -r --filter=manager dev",
    "test:manager": "pnpm -r --filter=manager test",
    "test:manager:watch": "pnpm -r --filter=manager test:watch",
    "test:manager:ui": "pnpm -r --filter=manager test:ui",
    "test:manager:cov": "pnpm -r --filter=manager test:coverage",
    "test:manager:cov:open": "pnpm -r --filter=manager test:coverage:open",
    "dev:tx-example": "pnpm -r --filter=@ens-apps/transaction-manager-example dev",
    "e2e": "pnpm --filter @ens-apps/e2e test:manager",
    "e2e:manager": "pnpm --filter @ens-apps/e2e test:manager",
    "e2e:manager-premium": "pnpm --filter @ens-apps/e2e test:manager-premium",
    "e2e:portal": "pnpm --filter @ens-apps/e2e test:portal",
    "e2e:cross-app": "pnpm --filter @ens-apps/e2e test:cross-app",
    "e2e:infra:up": "pnpm --filter @ens-apps/e2e infra:up",
    "e2e:infra:down": "pnpm --filter @ens-apps/e2e infra:down"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^5.70.2",
    "lefthook": "^2.1.6",
    "wrangler": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "esbuild",
      "@swc/core",
      "protobufjs",
      "keccak",
      "oxc-resolver",
      "workerd",
      "sharp",
      "@tailwindcss/oxide"
    ],
    "patchedDependencies": {
      "xstate": "patches/xstate.patch",
      "class-variance-authority": "patches/class-variance-authority.patch",
      "@rhinestone/sdk@1.8.0": "patches/@rhinestone%2Fsdk@1.8.0.patch"
    },
    "overrides": {
      "available-typed-arrays": "npm:@socketregistry/available-typed-arrays@^1",
      "es-define-property": "npm:@socketregistry/es-define-property@^1",
      "for-each": "npm:@socketregistry/for-each@^1",
      "function-bind": "npm:@socketregistry/function-bind@^1",
      "gopd": "npm:@socketregistry/gopd@^1",
      "has-property-descriptors": "npm:@socketregistry/has-property-descriptors@^1",
      "has-symbols": "npm:@socketregistry/has-symbols@^1",
      "has-tostringtag": "npm:@socketregistry/has-tostringtag@^1",
      "hasown": "npm:@socketregistry/hasown@^1",
      "indent-string": "npm:@socketregistry/indent-string@^1",
      "is-arguments": "npm:@socketregistry/is-arguments@^1",
      "is-core-module": "npm:@socketregistry/is-core-module@^1",
      "is-generator-function": "npm:@socketregistry/is-generator-function@^1",
      "is-regex": "npm:@socketregistry/is-regex@^1",
      "is-typed-array": "npm:@socketregistry/is-typed-array@^1",
      "isarray": "npm:@socketregistry/isarray@^1",
      "object-assign": "npm:@socketregistry/object-assign@^1",
      "path-parse": "npm:@socketregistry/path-parse@^1",
      "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
      "safe-regex-test": "npm:@socketregistry/safe-regex-test@^1",
      "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
      "set-function-length": "npm:@socketregistry/set-function-length@^1",
      "string.prototype.codepointat": "npm:@socketregistry/string.prototype.codepointat@^1",
      "typed-array-buffer": "npm:@socketregistry/typed-array-buffer@^1",
      "which-typed-array": "npm:@socketregistry/which-typed-array@^1",
      "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@^1",
      "vite@8.0.10>rolldown": "1.0.0-rc.18"
    }
  }
}
