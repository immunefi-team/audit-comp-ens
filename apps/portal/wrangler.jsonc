{
  "name": "portal-app",
  "compatibility_date": "2025-07-08",
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/icons/*",
      "!/client/*"
    ]
  },
  "preview_urls": true
}
