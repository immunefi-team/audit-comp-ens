{
  "include": ["server/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],

    /* Node runs these files directly via native type stripping, so we only
       type-check — never emit — and allow importing `.ts` specifiers. */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "strict": true,
    "noUncheckedSideEffectImports": true
  }
}
