# ============================================================================
# E2E Test Environment
#
# Copy this file to .env before running tests:
#   cp e2e/.env.example e2e/.env
#
# Start the local infra stack:
#   pnpm e2e:infra:up
# ============================================================================

# --- Chain (Anvil Sepolia fork) ---
VITE_SEPOLIA_RPC_URL=http://127.0.0.1:8545

# --- Bundler (local Alto instead of Pimlico cloud) ---
VITE_PIMLICO_BUNDLER_URL=/bundler

# --- Paymaster (mock-verifying-paymaster — sponsors gas on the fork) ---
VITE_PAYMASTER_URL=/paymaster

# --- App URLs ---
MANAGER_APP_URL=http://localhost:3000
PORTAL_APP_URL=http://localhost:3001

# --- E2E test credentials (Playwright) ---
PARA_E2E_EMAIL=test1@test.getpara.com
PARA_E2E_PIN=123456
E2E_DOMAIN=e2e-ci.eth

# --- App keys (copy from your app .env) ---
# VITE_PARA_API_KEY=
# VITE_API_URL=
# VITE_TELEGRAM_BOT_ID=
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=
# VITE_RHINESTONE_API_KEY=
# VITE_PIMLICO_API_KEY=

# --- Feature flags ---
VITE_FF_DISCOUNTS_APPLIED=false
VITE_FF_SKIP_NOTIFICATION_SETTINGS=false

# --- Indexer mock (set to true when Panoptes is not running) ---
# E2E_MOCK_INDEXER=true
